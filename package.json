{
  "name": "@foleyjs/core",
  "version": "2.5.0",
  "description": "Sound effects for the interface, performed live. 28 interaction cues synthesized with Web Audio \u2014 zero dependencies, zero audio files.",
  "type": "module",
  "main": "./src/foley.js",
  "module": "./src/foley.js",
  "types": "./src/foley.d.ts",
  "exports": {
    ".": {
      "types": "./src/foley.d.ts",
      "import": "./src/foley.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build-standalone.mjs",
    "demo": "npx serve .",
    "docs": "node scripts/build-docs.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eakbulut/foley.git"
  },
  "homepage": "https://usefoley.dev/",
  "bugs": {
    "url": "https://github.com/eakbulut/foley/issues"
  },
  "keywords": [
    "web-audio",
    "ui-sounds",
    "sound-effects",
    "interaction",
    "sfx",
    "microinteractions",
    "audio",
    "synthesis"
  ],
  "author": "eakbulut",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@foleyjs/core": "file:.",
    "marked": "^18.0.7",
    "react": "^18.3.0"
  }
}
