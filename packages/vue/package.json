  "files": ["src", "README.md"],
  "sideEffects": false,
  "peerDependencies": {
    "@foleyjs/core": "^2.3.0",
    "vue": ">=3"
  },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eakbulut/foley.git",
    "directory": "packages/vue"
  },
  "homepage": "https://eakbulut.github.io/foley/",
  "keywords": ["vue", "directive", "web-audio", "ui-sounds", "sound-effects"],
  "author": "eakbulut",
  "license": "MIT"
