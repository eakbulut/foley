{
  "name": "@foleyjs/vue",
  "version": "2.3.0",
  "description": "Vue 3 bindings for Foley — sound effects for the interface, performed live.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
